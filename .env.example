# ─── Agent's List environment example ────────────────────────────────────────
# Copy to `.env` (loaded automatically at startup; real env vars win).
# Every value has a safe default: the app boots with this file empty, with no
# network access, and chain features degrade gracefully (503 / pending orders).

# ─── Flask ────────────────────────────────────────────────────────────────────
FLASK_ENV=development              # development | testing | production
SECRET_KEY=change-me               # required in production
# Default: SQLite at instance/agents_list.db. docker-compose.yml sets Postgres.
# DATABASE_URL=sqlite:///agents_list.db
# DATABASE_URL=postgresql://agents:agents@localhost:5433/agents_list
# AUTO_MIGRATE=1                   # run `alembic upgrade head` at boot (default on outside production)
# STRICT_PROD_VALIDATION=1         # in production: fail fast on unsafe config
# Hosting behind a proxy / on Vercel (docs/deploy/vercel.md). On Vercel (VERCEL=1,
# set by the platform) the default config is production and SQLite is refused.
# TRUST_PROXY=1                    # trust one proxy's X-Forwarded-*; default on only on Vercel
# SESSION_COOKIE_SECURE=1          # HTTPS-only session cookie; default on in production

# ─── CORS / rate limit ────────────────────────────────────────────────────────
# CORS_ORIGINS=https://agentslist.example,https://app.agentslist.example
# RATELIMIT_DEFAULT=600/minute
# RATELIMIT_STORAGE_URI=memory://  # per process; a shared store (e.g. redis://) counts across instances

# ─── API auth (protects /admin/* mutations) ──────────────────────────────────
# API_KEY=pick-a-long-random-string

# ─── Chain: Ethereum Sepolia (defaults shown) ────────────────────────────────
# Public RPCs are rate-limited; use a keyed Alchemy/Infura URL for real use:
#   RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<key>
#   RPC_URL=https://sepolia.infura.io/v3/<key>
# RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# CHAIN_ID=11155111
# CHAIN_NAME=Ethereum Sepolia
# EXPLORER_URL=https://sepolia.etherscan.io
# RPC_TIMEOUT_SECONDS=10

# ─── Chain: signer keys (hex, with or without 0x) ────────────────────────────
# Separate keys per role; there is no shared PRIVATE_KEY fallback.
# FACILITATOR_PRIVATE_KEY pays gas to submit buyer-signed USDC authorizations.
#   Fund it with Sepolia ETH (Google Cloud Web3 faucet, Alchemy/Infura faucets).
# GATEKEEPER_PRIVATE_KEY signs incidents on a legacy ReputationContract only.
# FACILITATOR_PRIVATE_KEY=0x...
# GATEKEEPER_PRIVATE_KEY=0x...
# MIN_SIGNER_ETH_RESERVE=0.01      # refuse txs that would drop the signer below this
# Transactions are EIP-1559 (type 2): maxFee = 2 x baseFee + tip.
# PRIORITY_FEE_GWEI=1.5            # tip used when the node can't suggest one
# MAX_FEE_GWEI=                    # optional hard cap on maxFeePerGas

# Treasury address that receives buyer payments until EngagementEscrow ships.
# PAYMENT_RECIPIENT=0x...

# ─── Chain: contract addresses ───────────────────────────────────────────────
# Payment token: Circle USDC on Sepolia (default). Get test USDC at
# https://faucet.circle.com. Point this at a mintable EIP-3009 mock only for
# CI/load tests. The EIP-712 domain is read from the token (fallback USDC / 2).
# USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
# DOMAIN_CACHE_SECONDS=3600
# Canonical ERC-8004 registries on Sepolia (defaults):
# ERC8004_IDENTITY_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e
# ERC8004_REPUTATION_REGISTRY=0x8004B663056A597Dffe9eCcC1965A193B7388713
# Legacy contracts: no Sepolia deployment; features that need them
# return 503 unless you point these at a redeploy.
# AGENT_REGISTRY_ADDRESS=0x...
# REPUTATION_ADDRESS=0x...
# ESCROW_ADDRESS=0x...
# STAKING_ADDRESS=0x...

# ─── Specialist kit (agentkit/, `python -m agentkit`) ─────────────────────────
# Only the harness reads these; the web app never does. Tests need none.
# Model refs are "provider:model". Runs use agent.yaml's models (the model the
# operator stamped). Development only: set AGENTKIT_ALLOW_MODEL_OVERRIDE=1 to let
# --model and the three variables below override them; without it they are ignored.
# AGENTKIT_ALLOW_MODEL_OVERRIDE=1                 # never set this in production
# AGENTKIT_MODEL=anthropic:claude-opus-5         # overrides the manifest's primary model
# AGENTKIT_FALLBACK_MODELS=openai:<model>,gemini:<model>   # tried in order on errors/refusals
# AGENTKIT_GRADER_MODEL=anthropic:claude-sonnet-5  # rubric grader (another family is recommended)
# AGENTKIT_PRICING_FILE=pricing.yaml              # YAML "provider:model": {input, output} $/MTok
# Provider keys (only for the providers you use):
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434/v1       # local Ollama; no key needed
# Any other OpenAI-compatible server (vllm:/openai_compat: refs):
# AGENTKIT_OPENAI_COMPAT_BASE_URL=http://localhost:8000/v1
# AGENTKIT_OPENAI_COMPAT_API_KEY=
# financial-research: SEC EDGAR User-Agent (organization and contact email),
# used only when the engagement's intake declares none.
# SEC_USER_AGENT=Example Research ops@example.com

# ─── Optional LLM (OpenAI-compatible endpoint) ─────────────────────────────────
# Used for the preview on agent pages, to read uploaded statements of work
# (POST /api/sow/parse) and by the matchmaker that picks the agent for a job
# (POST /api/intake/match, app/intake/matchmaker.py). Without it rule-based
# fallbacks run. LLM_URL is the base URL without /v1 (the client appends
# /v1/chat/completions), e.g. a vLLM deployment's public URL.
# LLM_URL=http://localhost:8000
# LLM_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct
# LLM_API_KEY=
# Seconds the matchmaker waits for the model before using its rules (default 25).
# MATCHMAKER_TIMEOUT_SECONDS=25

# One demo agent (FINANCE_DEMO_AGENT_ID) can use a second, dedicated endpoint
# for its "ask this agent" preview and its task deliverables instead of the
# default LLM_URL above - useful for wiring one specialist's live demo to its
# own hosted model.
# FINANCE_LLM_URL=http://localhost:8001
# FINANCE_LLM_MODEL=qwen3-financial-agent
# FINANCE_LLM_API_KEY=
# FINANCE_DEMO_AGENT_ID=AGT-XXXX-XXXX-X

# ─── Human identity: World ID (OpenID Connect) ───────────────────────────────
# Register an OIDC client in the World ID portal; see docs/integrations/world-id.md.
# WORLD_ISSUER=https://sandbox.auth.world.org
# WORLD_CLIENT_ID=app_...
# WORLD_CLIENT_SECRET=...
# WORLD_REDIRECT_URI=http://localhost:8090/auth/world/callback
# WORLD_ALLOWED_HOSTS=my-branch-agents.vercel.app   # only when WORLD_REDIRECT_URI is unset:
#                                  # https://<host>/auth/world/callback for these exact hosts
# WORLD_REQUIRED_ACR=https://world.org/oidc/acr/orb-v3   # optional: require Orb-level verification

# ─── Approvals ───────────────────────────────────────────────────────────────
# APPROVAL_TTL_SECONDS=180                        # an approval request expires after this
# STEPUP_MAX_AGE_SECONDS=300                      # max age of the human's authentication
# HUMAN_WEEKLY_CAP_USDC=                          # per-human weekly spend cap (fund + sub-hire)

# ─── Screening: payer and payee risk checks ──────────────────────────────────
# INTERCEPTA_API_KEY=                             # missing key → every payment is refused (fail closed)
# INTERCEPTA_BASE_URL=https://api.web3antivirus.io   # screening API base URL
# SCREENING_ADDRESS_MAP=                          # JSON {"<sepolia addr>": "<mainnet addr>"} to screen
# SCREENING_TIMEOUT_SECONDS=4                     # timeout → REFUSE
# SCREENING_REFUSE_SCORE=80                       # provider publishes no thresholds; ours are explicit
# SCREENING_ASK_SCORE=60
# SCREENING_CAP_SCORE=30
# SCREENING_CAP_USDC=10                           # payment cap when the verdict is CAP

# ─── Escrow and mandates ─────────────────────────────────────────────────────
# ESCROW_PRIVATE_KEY=0x...                        # escrow wallet; unset → ledger entries are simulated
# BUYER_VAULT_PRIVATE_KEY=0x...                   # buyer vault that signs EIP-3009 funding authorizations
# MANDATE_SIGNING_KEY=                            # ES256 PEM; dev generates instance/mandate_key.pem
# MANDATE_MAX_DEPTH=2                             # max sub-hire depth below the root mandate

# ─── Agent tasks (x402 v2) ───────────────────────────────────────────────────
# AGENT_TASK_PRICE_USDC=0.05                      # price of POST /api/agents/<id>/tasks when the stamped manifest has no price_min
# X402_MAX_PAYMENT_USDC=10                        # upper bound on any single x402 task payment

# ─── Names sidecar ───────────────────────────────────────────────────────────
# ENS_SIDECAR_URL=http://127.0.0.1:8787           # names sidecar base URL
# ENS_SIDECAR_TOKEN=                              # shared secret sent as X-Sidecar-Token
# ENS_SIDECAR_TIMEOUT=15                          # seconds per sidecar call
# ENS_ROOT_NAME=agentslist-app.eth                # parent name for agent and job names
# ENS_RESOLVE_PAYEES=0                            # 1: require an active ENS name + x402-payto record; fail closed on mismatch/unresolved lookup
# ENS_UNIVERSAL_RESOLVER=0xeEeEEEeE14D718C2B47D9923Deab1335E144EeEe   # ENSv2 Universal Resolver (Sepolia); read via RPC_URL
# Sidecar only (ens/, see ens/README.md), never read by the app:
# ENS_ROOT_LABEL=agentslist-app                   # label registered as <label>.eth
# ENS_OPERATOR_PRIVATE_KEY=0x...                  # fresh platform hot wallet, Sepolia ETH only
# SEPOLIA_RPC_URL=https://...                     # Sepolia JSON-RPC for the sidecar
# DRY_RUN=1                                       # sidecar: no network, fake tx hashes

# ─── MCP server ──────────────────────────────────────────────────────────────
# MCP_API_BASE=http://localhost:8090              # app base URL the MCP server calls
# MCP_API_TOKEN=                                  # bearer token the MCP server presents

# ─── Job estimates ────────────────────────────────────────────────────────────
# Optional JSON file of measured token usage per job category. When set, those
# categories are estimated from it (and labelled with their run count) instead
# of the built-in heuristic. Format: see app/intake/token_model.py.
# TOKEN_CALIBRATION_PATH=/path/to/token-calibration.json
