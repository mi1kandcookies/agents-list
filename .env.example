# ─── Agent's List environment example ────────────────────────────────────────
# Copy to `.env` (loaded automatically at startup; real env vars win).
# Every value has a safe default: the app boots with this file empty, with no
# network access, and chain features degrade gracefully (503 / pending orders).

# ─── Flask ────────────────────────────────────────────────────────────────────
FLASK_ENV=development              # development | testing | production
SECRET_KEY=change-me               # required in production
# Default: SQLite at instance/agents_list.db. docker-compose.yml sets Postgres.
# DATABASE_URL=sqlite:///agents_list.db
# DATABASE_URL=postgresql://agents:agents@localhost:5433/agents_list
# AUTO_MIGRATE=1                   # run `alembic upgrade head` at boot (default on outside production)
# STRICT_PROD_VALIDATION=1         # in production: fail fast on unsafe config

# ─── CORS / rate limit ────────────────────────────────────────────────────────
# CORS_ORIGINS=https://agentslist.example,https://app.agentslist.example
# RATELIMIT_DEFAULT=600/minute

# ─── API auth (protects /admin/* mutations) ──────────────────────────────────
# API_KEY=pick-a-long-random-string

# ─── Chain: Ethereum Sepolia (defaults shown) ────────────────────────────────
# Public RPCs are rate-limited; use a keyed Alchemy/Infura URL for real use:
#   RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<key>
#   RPC_URL=https://sepolia.infura.io/v3/<key>
# RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# CHAIN_ID=11155111
# CHAIN_NAME=Ethereum Sepolia
# EXPLORER_URL=https://sepolia.etherscan.io
# RPC_TIMEOUT_SECONDS=10

# ─── Chain: signer keys (hex, with or without 0x) ────────────────────────────
# Separate keys per role; there is no shared PRIVATE_KEY fallback.
# FACILITATOR_PRIVATE_KEY pays gas to submit buyer-signed USDC authorizations.
#   Fund it with Sepolia ETH (Google Cloud Web3 faucet, Alchemy/Infura faucets).
# GATEKEEPER_PRIVATE_KEY signs incidents on a legacy ReputationContract only.
# FACILITATOR_PRIVATE_KEY=0x...
# GATEKEEPER_PRIVATE_KEY=0x...
# MIN_SIGNER_ETH_RESERVE=0.01      # refuse txs that would drop the signer below this
# Transactions are EIP-1559 (type 2): maxFee = 2 x baseFee + tip.
# PRIORITY_FEE_GWEI=1.5            # tip used when the node can't suggest one
# MAX_FEE_GWEI=                    # optional hard cap on maxFeePerGas

# Treasury address that receives buyer payments until EngagementEscrow ships.
# PAYMENT_RECIPIENT=0x...

# ─── Chain: contract addresses ───────────────────────────────────────────────
# Payment token: Circle USDC on Sepolia (default). Get test USDC at
# https://faucet.circle.com. Point this at a mintable EIP-3009 mock only for
# CI/load tests. The EIP-712 domain is read from the token (fallback USDC / 2).
# USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
# DOMAIN_CACHE_SECONDS=3600
# Canonical ERC-8004 registries on Sepolia (defaults):
# ERC8004_IDENTITY_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e
# ERC8004_REPUTATION_REGISTRY=0x8004B663056A597Dffe9eCcC1965A193B7388713
# Legacy prototype contracts: no Sepolia deployment; features that need them
# return 503 unless you point these at a redeploy.
# AGENT_REGISTRY_ADDRESS=0x...
# REPUTATION_ADDRESS=0x...
# ESCROW_ADDRESS=0x...
# STAKING_ADDRESS=0x...

# ─── Optional LLM preview on agent pages (OpenAI-compatible endpoint) ────────
# LLM_URL=http://localhost:8000
# LLM_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct
# LLM_API_KEY=

# ─── Protected named-agent hiring ────────────────────────────────────────────
# ENSv2 uses the active Sepolia RPC and the deployed Universal Resolver V2.
# Default mode is live and fail-closed. For a local-only demo, explicitly set
# ENS_MODE=fixture and provide a JSON mapping; fixture values are never a live
# ENS claim.
# ENS_MODE=live
# ENS_UNIVERSAL_RESOLVER=0xeEeEEEeE14D718C2B47D9923Deab1335E144EeEe
# AGENT_ENDPOINT_ORIGIN=https://qa.example.test
# ENS_FIXTURES_JSON={"qa.example.eth":{"address":"0x0000000000000000000000000000000000000001","endpoint":"https://qa.example.test/work","enabled":true,"status":"online","resolver":"fixture"}}

# The application-specific records read through ENSv2.
# com.agentslist.work-endpoint, com.agentslist.enabled, com.agentslist.status

# Intercepta Quick Scan Address. A missing URL/key or unknown response is HOLD.
# INTERCEPTA_MODE=live
# INTERCEPTA_QUICK_SCAN_URL=https://<your-intercepta-host>/...
# INTERCEPTA_API_KEY=
# INTERCEPTA_DECISION_PATH=decision
# INTERCEPTA_REASON_PATH=reason
# For local-only tests, use INTERCEPTA_MODE=fixture and set the explicit result.
# INTERCEPTA_FIXTURE_DECISION=ALLOW
# INTERCEPTA_DENY_ADDRESS=0x0000000000000000000000000000000000000002

# Private, same-chain facilitator for official x402 exact/EVM settlement.
# Do not expose this endpoint or its credentials to the browser.
# PAYMENT_FACILITATOR_URL=http://127.0.0.1:8403

# The teammate's backend calls /api/hiring/approvals/<id>/validated only after
# validating identity and explicit consent for the exact intent hash.
# APPROVAL_SERVICE_KEY=
# HIRE_INTENT_TTL_SECONDS=900

# Local demo only. This bypasses chain settlement and is labelled in receipts;
# never enable it outside localhost.
# HIRE_LOCAL_APPROVAL=1
# HIRE_PAYMENT_MODE=mock
