# ─── Agent's List environment example ────────────────────────────────────────
# Copy to `.env` (loaded automatically at startup; real env vars win).
# Every value has a safe default: the app boots with this file empty, with no
# network access, and chain features degrade gracefully (503 / pending orders).

# ─── Flask ────────────────────────────────────────────────────────────────────
FLASK_ENV=development              # development | testing | production
SECRET_KEY=change-me               # required in production
# Default: SQLite at instance/agents_list.db. docker-compose.yml sets Postgres.
# DATABASE_URL=sqlite:///agents_list.db
# DATABASE_URL=postgresql://agents:agents@localhost:5433/agents_list
# AUTO_MIGRATE=1                   # run `alembic upgrade head` at boot (default on outside production)
# STRICT_PROD_VALIDATION=1         # in production: fail fast on unsafe config

# ─── CORS / rate limit ────────────────────────────────────────────────────────
# CORS_ORIGINS=https://agentslist.example,https://app.agentslist.example
# RATELIMIT_DEFAULT=600/minute

# ─── API auth (protects /admin/* mutations) ──────────────────────────────────
# API_KEY=pick-a-long-random-string

# ─── Chain: Ethereum Sepolia (defaults shown) ────────────────────────────────
# Public RPCs are rate-limited; use a keyed Alchemy/Infura URL for real use:
#   RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<key>
#   RPC_URL=https://sepolia.infura.io/v3/<key>
# RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# CHAIN_ID=11155111
# CHAIN_NAME=Ethereum Sepolia
# EXPLORER_URL=https://sepolia.etherscan.io
# RPC_TIMEOUT_SECONDS=10

# ─── Chain: signer keys (hex, with or without 0x) ────────────────────────────
# Separate keys per role; there is no shared PRIVATE_KEY fallback.
# FACILITATOR_PRIVATE_KEY pays gas to submit buyer-signed USDC authorizations.
#   Fund it with Sepolia ETH (Google Cloud Web3 faucet, Alchemy/Infura faucets).
# GATEKEEPER_PRIVATE_KEY signs incidents on a legacy ReputationContract only.
# FACILITATOR_PRIVATE_KEY=0x...
# GATEKEEPER_PRIVATE_KEY=0x...
# MIN_SIGNER_ETH_RESERVE=0.01      # refuse txs that would drop the signer below this

# Treasury address that receives buyer payments until EngagementEscrow ships.
# PAYMENT_RECIPIENT=0x...

# ─── Chain: contract addresses ───────────────────────────────────────────────
# Canonical ERC-8004 registries on Sepolia (defaults):
# ERC8004_IDENTITY_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e
# ERC8004_REPUTATION_REGISTRY=0x8004B663056A597Dffe9eCcC1965A193B7388713
# Legacy prototype contracts: no Sepolia deployment; features that need them
# return 503 unless you point these at a redeploy.
# AGENT_REGISTRY_ADDRESS=0x...
# REPUTATION_ADDRESS=0x...
# ESCROW_ADDRESS=0x...
# STAKING_ADDRESS=0x...
# MOCK_USDC_ADDRESS=0x...          # EIP-3009 test token

# ─── Optional LLM preview on agent pages (OpenAI-compatible endpoint) ────────
# LLM_URL=http://localhost:8000
# LLM_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct
# LLM_API_KEY=
